# ===== LLM 模型选择（推荐：模型注册表，见 config.py LLM_MODELS） =====
# 可选: qwen3-coder-30b(默认,ModelScope,已验证) | glm-5.2 | minimax-m3 | nemotron-49b | moonshot-128k | moonshot-32k | kimi-k2 | qwen3-32b
LLM_MODEL=qwen3-coder-30b

# ===== 旧式 provider 切换（未设置 LLM_MODEL 时兜底） =====
LLM_PROVIDER=moonshot

# ===== Moonshot / Kimi（默认） =====
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# 长上下文候选：moonshot-v1-128k（128k，推荐）/ moonshot-v1-32k / kimi-k2-0711-preview（128k）
MOONSHOT_MODEL=moonshot-v1-128k

# ===== ModelScope（备用，Qwen 免费额度） =====
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1/
MODELSCOPE_MODEL=Qwen/Qwen3-32B

# ===== NVIDIA build（默认模型 minimax-m3） =====
# 在 https://build.nvidia.com/minimaxai/minimax-m3 注册获取 nvapi-... key
NVIDIA_API_KEY=

# ===== Agent 参数 =====
MAX_STEPS=15
TOOL_OUTPUT_MAX_CHARS=2000
LLM_TEMPERATURE=0.3
SESSION_TIMEOUT_SECONDS=300
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# 全局限速覆盖（秒）：0 = 按模型注册表各自的 min_interval；
# 若 ReAct 会话仍 429，可调大（如 4-5）强制所有模型间隔
LLM_MIN_INTERVAL=0

# ===== JWT =====
JWT_SECRET=please-change-me
JWT_EXPIRE_MINUTES=10080

# ===== Embedding (国内下载失败时: HF_ENDPOINT=https://hf-mirror.com) =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== RAG 分块 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ===== 存储路径 (默认 backend/data 下) =====
# DATABASE_PATH=
# CHROMA_PATH=